import("//base/msdp/device_status/device_status.gni")
import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
import("//build/ohos/taihe_idl/taihe.gni")

copy_taihe_idl("behaviorAwareness_taihe") {
  sources = [ "idl/ohos.multimodalAwareness.behaviorAwareness.taihe" ]
}

subsystem_name = "msdp"
part_name = "device_status"
taihe_generated_file_path =
    "$taihe_file_path/out/$subsystem_name/$part_name/behaviorAwareness"

ohos_taihe("run_taihe") {
  taihe_generated_file_path = "$taihe_generated_file_path"
  deps = [ ":behaviorAwareness_taihe" ]
  outputs = [
    "$taihe_generated_file_path/src/ohos.multimodalAwareness.behaviorAwareness.ani.cpp",
    "$taihe_generated_file_path/src/ohos.multimodalAwareness.behaviorAwareness.abi.c",
  ]
}

generate_static_abc("behaviorAwareness") {
  base_url = "$taihe_generated_file_path"
  files = [ "$taihe_generated_file_path/@ohos.multimodalAwareness.behaviorAwareness.ets" ]
  is_boot_abc = "True"
  device_dst_file = "/system/framework/behaviorAwareness.abc"
  dependencies = [ ":run_taihe" ]
}

ohos_prebuilt_etc("behaviorAwareness_etc") {
  source = "$target_out_dir/behaviorAwareness.abc"
  module_install_dir = "framework"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  deps = [ ":behaviorAwareness" ]
}

taihe_shared_library("behaviorAwareness_ani") {
  taihe_generated_file_path = "$taihe_generated_file_path"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  sources = get_target_outputs(":run_taihe")
  shlib_type = "ani"
  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  include_dirs = [
    "include",
    "${device_status_utils_path}/include",
    "${device_status_interfaces_path}/innerkits/include",
    "${device_status_intention_path}/prototype/include",
    "${device_status_intention_path}/ipc/tunnel/include",
    "${device_status_intention_path}/behavior_awareness/server/include",
    "${device_status_intention_path}/ipc/sequenceable_types/include",
    "${taihe_generated_file_path}/include",
    "${target_out_dir}/behaviorAwareness_ani_action/taihe_repo/taihe/include",
    "${root_out_dir}/gen/base/msdp/device_status/intention/ipc/tunnel",
  ]
  sources += [
    "src/ani_constructor.cpp",
    "src/behavior_awareness_manager.cpp",
    "src/behavior_awareness_callback_taihe.cpp",
    "src/ohos.multimodalAwareness.behaviorAwareness.impl.cpp",
  ]
  deps = [
    ":run_taihe",
    "${device_status_interfaces_path}/innerkits:devicestatus_client",
    "${device_status_utils_path}:devicestatus_util",
    "${device_status_intention_path}/behavior_awareness/server:behavior_awareness_server",
    "${device_status_intention_path}/ipc/tunnel:intention_client",
  ]
  external_deps = [
    "access_token:libaccesstoken_sdk",
    "c_utils:utils",
    "graphic_2d:librender_service_base",
    "graphic_2d:librender_service_client",
    "hilog:libhilog",
    "image_framework:image_native",
    "ipc:ipc_single",
    "samgr:samgr_proxy",
  ]

  defines = [ "DEVICE_STATUS_BEHAVIOR_AWARENESS_ENABLE" ]
}

group("behaviorAwareness_module") {
  deps = []
  if (device_status_behavior_awareness_enable) {
    deps = [
      ":behaviorAwareness_etc",
      ":behaviorAwareness_ani",
    ]
  }
}
