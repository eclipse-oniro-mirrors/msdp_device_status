@!namespace("@ohos.multimodalAwareness.behaviorAwareness", "behaviorAwareness")
@!sts_inject("""
static { loadLibraryWithPermissionCheck("behaviorAwareness_ani.z", "@ohos.multimodalAwareness.behaviorAwareness"); }
""")

enum PerceptionDomain : String {
    HABIT_AWARENESS = "habitAwareness",
}

enum PatternType : String {
    TIME_PATTERN = "timePattern",
    LOCATION_PATTERN = "locationPattern",
    EVENT_PATTERN = "eventPattern",
}

enum EventType : String {
    DAILY_TIME = "dailyTime",
    WEEKLY_TIME = "weeklyTime",
    MONTHLY_TIME = "monthlyTime",
    WORKDAY_TIME = "workdayTime",
    LOCATION_ARRIVE = "locationArrive",
    APP_LAUNCH = "appLaunch",
    APP_EXIT = "appExit",
    APP_USAGE_SINGLE = "appUsageSingle",
    APP_USAGE_DAILY = "appUsageDaily",
    ALARM_DISMISS = "alarmDismiss",
    CHARGE_START = "chargeStart",
    CHARGE_END = "chargeEnd",
    CHARGE_FULL = "chargeFull",
    BATTERY_ABOVE = "batteryAbove",
    BATTERY_BELOW = "batteryBelow",
    BLUETOOTH_CONNECT = "bluetoothConnect",
    BLUETOOTH_DISCONNECT = "bluetoothDisconnect",
    PHONE_RING = "phoneRing",
}

enum ActionType : String {
    APP_CLOSE = "appClose",
    APP_OPEN = "appOpen",
    EYE_PROTECT_MODE = "eyeProtectMode",
    DARK_MODE = "darkMode",
    PERSONAL_HOTSPOT = "personalHotspot",
    MOBILE_DATA = "mobileData",
    WIFI = "wifi",
    AIRPLANE_MODE = "airplaneMode",
    BLUETOOTH = "bluetooth",
    NFC = "nfc",
    ROTATION_LOCK = "rotationLock",
    POWER_SAVING = "powerSaving",
    SOUND_MODE = "soundMode",
    SCREEN_BRIGHTNESS = "screenBrightness",
    VOLUME = "volume",
    SHUTDOWN = "shutdown",
    REBOOT = "reboot",
}

enum SoundMode : String {
    VIBRATE = "vibrate",
    SILENT = "silent",
    RING = "ring",
}

enum BluetoothDeviceType : i32 {
    DEFAULT = 0,
    CAR = 1,
    HEADSET = 2,
    HEARING = 3,
    GLASSES = 4,
    WATCH = 5,
    SPEAKER = 6,
    OTHERS = 7,
}

enum FeedbackType : i32 {
    ACCEPT = 0,
    IGNORE = 1,
    REJECT = 2,
    EDIT = 3,
    NOT_PUSHED = 4,
}

enum RecurrenceType : String {
    DAILY = "daily",
    WEEKLY = "weekly",
    MONTHLY = "monthly",
    WORKDAY = "workday",
}

enum LocationType : String {
    HOME = "home",
    COMPANY = "company",
    CUSTOM = "custom",
}

enum Operation : String {
    ON = "on",
    OFF = "off",
    TOGGLE = "toggle",
}

enum AdjustmentDirection : String {
    UP = "up",
    DOWN = "down",
}

struct SubscribeOptions {
    domain: PerceptionDomain;
    patternTypes: Optional<Array<PatternType>>;
}

struct PerceptionEvent {
    perceptionEventId: String;
    domain: PerceptionDomain;
    confidence: i32;
    generateTime: i64;
    payload: @record Map<String, Opaque>;
}

struct FeedbackData {
    perceptionEventId: String;
    feedbackType: i32;
    feedbackTime: i64;
}

@rename("onPerception")
function OnPerception(
    options: SubscribeOptions,
    callback: (data: PerceptionEvent) => void): void;

@rename("offPerception")
function OffPerception(
    callback: Optional<(data: PerceptionEvent) => void>): void;

@rename("submitFeedback")
function SubmitFeedback(feedback: FeedbackData): void;
