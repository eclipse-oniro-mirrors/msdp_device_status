import("../../../../device_status.gni")

config("device_behavior_awareness_private_config") {
  include_dirs = [ "include" ]
}

ohos_shared_library("behaviorawareness_napi") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [
    "${device_status_frameworks_path}/js/napi/behaviorAwareness/src/behavior_awareness_napi.cpp",
    "${device_status_frameworks_path}/js/napi/behaviorAwareness/src/behavior_awareness_napi_error.cpp",
    "${device_status_frameworks_path}/native/src/behavior_awareness_callback_stub.cpp",
    "${device_status_frameworks_path}/native/src/behavior_awareness_callback_proxy.cpp",
    "${device_status_frameworks_path}/ets/behaviorAwareness/src/behavior_awareness_manager.cpp",
  ]

  include_dirs = [
    "include",
    "${device_status_frameworks_path}/ets/behaviorAwareness/include",
    "${device_status_interfaces_path}/innerkits/include",
    "${device_status_intention_path}/ipc/tunnel/include",
    "${device_status_intention_path}/prototype/include",
    "${device_status_intention_path}/behavior_awareness/server/include",
    "${device_status_intention_path}/ipc/sequenceable_types/include",
    "${root_out_dir}/gen/base/msdp/device_status/intention/ipc/tunnel",
    "${device_status_utils_path}/include",
  ]

  configs = [ ":device_behavior_awareness_private_config" ]

  deps = [
    "${device_status_utils_path}:devicestatus_util",
    "${device_status_interfaces_path}/innerkits:devicestatus_client",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "c_utils:utils",
    "graphic_2d:librender_service_base",
    "graphic_2d:librender_service_client",
    "hilog:libhilog",
    "image_framework:image_native",
    "ipc:ipc_single",
    "napi:ace_napi",
    "node:node_header_notice",
    "samgr:samgr_proxy",
  ]

  defines = []
  if (device_status_phone_standard_lite) {
    defines += [ "DEVICE_STATUS_PHONE_STANDARD_LITE" ]
  }
  defines += [ "DEVICE_STATUS_BEHAVIOR_AWARENESS_ENABLE" ]

  relative_install_dir = "module/multimodalawareness"
  subsystem_name = "msdp"
  part_name = "${device_status_part_name}"
}

group("behaviorawareness_napi_module") {
  deps = []
  if (device_status_behavior_awareness_enable) {
    deps = [ ":behaviorawareness_napi" ]
  }
}
