import("../../../../device_status.gni")

config("car_awareness_napi_private_config") {
  include_dirs = [
    "include"
  ]
}

ohos_shared_library("carawareness_napi") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [
    "${device_status_frameworks_path}/js/napi/car_awareness/src/car_awareness_mgr_napi.cpp",
    "${device_status_frameworks_path}/js/napi/car_awareness/src/car_awareness_napi.cpp",
    "${device_status_frameworks_path}/js/napi/car_awareness/src/car_awareness_napi_utils.cpp",
    "${device_status_frameworks_path}/js/napi/car_awareness/src/car_awareness_init.cpp",
  ]

  configs = [ ":car_awareness_napi_private_config" ]

  deps = [
    "${device_status_utils_path}:devicestatus_util",
    "${device_status_interfaces_path}/innerkits:devicestatus_client",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "napi:ace_napi",
    "ipc:ipc_single",
    "json:nlohmann_json_static"
  ]

  if (device_status_car_awareness_enable) {
    defines = [ "CAR_AWARENESS_ENABLE" ]
  }

  relative_install_dir = "module/multimodalawareness"
  subsystem_name = "msdp"
  part_name = "${device_status_part_name}"
}