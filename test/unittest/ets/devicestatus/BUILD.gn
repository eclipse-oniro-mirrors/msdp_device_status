import("//build/ohos/taihe_idl/taihe.gni")
import("//build/test.gni")
import("../../../../device_status.gni")

_taihe_unpack_dir = get_label_info(":prepare_taihe_runtime", "target_gen_dir") +
                    "/taihe_runtime"
_taihe_runtime_dir = "$_taihe_unpack_dir/taihe"

# Use the same packaged runtime as the public Taihe build template.
action("prepare_taihe_runtime") {
  testonly = true
  script = "//build/ohos/taihe_idl/unpack.py"
  sources = [ "$root_build_dir/obj/arkcompiler/taihe_ffi_gen/taihe_repo/taihe-linux-x86_64.tar.gz" ]
  outputs = [
    "$_taihe_unpack_dir/taihe_repo_stamp.h",
    "$_taihe_runtime_dir/src/taihe/runtime/object.cpp",
    "$_taihe_runtime_dir/src/taihe/runtime/runtime_ani.cpp",
    "$_taihe_runtime_dir/src/taihe/runtime/string.cpp",
  ]
  args = [
    "--src",
    rebase_path(sources[0], root_build_dir),
    "--dst",
    rebase_path(_taihe_unpack_dir, root_build_dir),
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
  ]
  external_deps = [ "taihe_ffi_gen:build_taihe_wrapper" ]
}

ohos_unittest("AniDropEventTest") {
  module_out_path = "device_status/device_status"
  testonly = true

  # Compile the real motion-enabled implementation even on open-source products.
  # Only closed-source motion headers are replaced, within this test target.
  defines = [ "MOTION_ENABLE" ]
  cflags = [ "-fno-access-control" ]

  include_dirs = [
    "mock",
    "${device_status_frameworks_path}/ets/devicestatus/include",
    "${device_status_utils_path}/include",
    "${device_status_utils_path}",
    "${taihe_file_path}/out/msdp/device_status/devicestatus/include",
    "$_taihe_runtime_dir/include",
  ]

  sources = [
    "$_taihe_runtime_dir/src/taihe/runtime/object.cpp",
    "$_taihe_runtime_dir/src/taihe/runtime/runtime_ani.cpp",
    "$_taihe_runtime_dir/src/taihe/runtime/string.cpp",
    "${device_status_frameworks_path}/ets/devicestatus/src/ani_drop_event.cpp",
    "src/ani_drop_event_test.cpp",
  ]

  deps = [
    ":prepare_taihe_runtime",
    "${device_status_frameworks_path}/ets/devicestatus:run_taihe",
  ]

  external_deps = [
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "googletest:gtest_main",
    "hilog:libhilog",
    "runtime_core:ani",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":AniDropEventTest" ]
}
