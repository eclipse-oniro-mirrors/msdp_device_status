import("//base/msdp/device_status/device_status.gni")

config("fusion_dm_config") {
  include_dirs = [ "include" ]

  defines = device_status_default_defines
}

config("fusion_dm_public_config") {
  include_dirs = [ "include" ]
}

ohos_shared_library("fusion_dm_binding") {
  branch_protector_ret = "pac_ret"

  sources = [ "src/dm_binding.cpp" ]

  deps = [ "${device_status_root_path}/utils/common:devicestatus_util" ]

  configs = [ ":fusion_dm_config" ]

  public_configs = [ ":fusion_dm_public_config" ]

  external_deps = [
    "c_utils:utils",
    "device_info_manager:distributed_device_profile_common",
    "device_info_manager:distributed_device_profile_sdk",
    "device_manager:devicemanagersdk",
    "hilog:libhilog",
  ]

  output_extension = "so"
  install_images = [ system_base_dir ]
  subsystem_name = "${device_status_subsystem_name}"
  part_name = "${device_status_part_name}"
}
